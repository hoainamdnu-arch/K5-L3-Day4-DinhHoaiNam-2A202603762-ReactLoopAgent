# Copy thành .env ở gốc repo; biến trong shell được ưu tiên. Không commit key thật.
PROVIDER=gemini
MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_REASONING_EFFORT=default
PROVIDER_TIMEOUT=120
PROVIDER_MAX_RETRIES=1
# Retry 429 có Retry-After/RetryInfo hợp lệ, tối đa 4 lần, delay API <=120s.
PROVIDER_RATE_RETRIES=4
JUDGE_PROVIDER=gemini
JUDGE_MODEL=gemini-3.5-flash-lite

# Các biến dưới chỉ có hiệu lực với adapter Groq; giữ để tái lập profile của lab.
# Khi chuyển Groq, đổi cả PROVIDER/MODEL và JUDGE_PROVIDER/JUDGE_MODEL.
# GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MAX_OUTPUT_TOKENS=768
GROQ_OUTPUT_HINT=Trả lời ngắn gọn, tối đa khoảng 150 từ; giữ nguyên định dạng mà yêu cầu hiện tại quy định.
GROQ_DISABLE_TOOL_VALIDATION=1
GROQ_TOOL_CALL_RETRIES=2

# Provider khác: thay PROVIDER/MODEL/JUDGE_* và đặt key tương ứng.
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
# OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

# OpenCode Go qua adapter openai:
# API_ENDPOINT=https://opencode.ai/inference/go/openai/v1
# API_KEY=YOUR_OPENCODE_KEY
